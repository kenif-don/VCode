+
+// ---- 日志右键「添加到对话」 ------------------------------------------------
+// 旧实现走 ui/message(以用户身份发送),宿主会弹「插件想以你的身份发送消息」确认框。
+// 现改为直接添加到对话输入区,不发送、不弹框:
+//   1) ui/insert-input-text(VCode 扩展桥方法):文本进输入框,用户改完自己发;
+//   2) 老宿主降级 ui/update-model-context:以「插件上下文」附在对话输入区,同样不弹框,
+//      发送时内容与正文一并送达模型;
+//   3) 输入框(composer)可能尚未挂载(切会话/加载中),宿主回 -32601「没人接住」——
+//      等待就绪后自动重试(ADD_WAIT_*),超时才退到剪贴板;
+//   4) 通道宿主根本没实现(方法不存在)时不再等,直接进下一通道/剪贴板。
+
+const ADD_WAIT_TIMEOUT_MS = 10000;
+const ADD_WAIT_STEP_MS = 500;
+let addInFlight = false;
+
+/** -32601 有两种:「方法不存在」=宿主没实现该通道(重试无意义);其余(如 No composer…) =暂时没接住,可等待重试。 */
+function isBridgeUnsupported(e) {
+  return /method not found|not available|不支持/i.test(String((e && e.message) || ""));
+}
+
+function hideCtxMenu() {
+  $("ctx-menu").hidden = true;
+}
+
+async function insertSelectionToInput(text) {
+  const payload = "【运行输出摘录 · " + (App.currentRunId || "未知运行") + "】\n" + text;
+  if (window.parent === window || !Bridge.connected) {
+    // 独立模式没有宿主可以代发,降级为复制到剪贴板
+    await copyText(payload);
+    toast("独立模式:无法添加到对话,已复制到剪贴板");
+    return;
+  }
+  if (addInFlight) {
+    toast("正在添加到对话,请稍候…");
+    return;
+  }
+  addInFlight = true;
+  try {
+    let insertOk = true, contextOk = true;
+    let waited = false;
+    const deadline = Date.now() + ADD_WAIT_TIMEOUT_MS;
+    for (;;) {
+      if (insertOk) {
+        try {
+          await Bridge.request("ui/insert-input-text", { text: payload }, 3000);
+          toast("已添加到对话");
+          return;
+        } catch (e) {
+          if (isBridgeUnsupported(e)) insertOk = false;
+        }
+      }
+      if (contextOk) {
+        try {
+          await Bridge.request("ui/update-model-context", {
+            content: [{ type: "text", text: payload }]
+          }, 3000);
+          toast("已添加到对话输入区(宿主不支持直插文本,以插件上下文附上)");
+          return;
+        } catch (e) {
+          if (isBridgeUnsupported(e)) contextOk = false;
+        }
+      }
+      if (!insertOk && !contextOk) {
+        // 两条通道宿主都没实现,再等也没用
+        await copyText(payload);
+        toast("宿主不支持添加到对话,已复制到剪贴板");
+        return;
+      }
+      if (Date.now() >= deadline) {
+        await copyText(payload);
+        toast("等待输入框就绪超时,已复制到剪贴板");
+        return;
+      }
+      if (!waited) {
+        waited = true;
+        toast("输入框尚未就绪,等待后自动添加…");
+      }
+      await new Promise((r) => setTimeout(r, ADD_WAIT_STEP_MS));
+    }
+  } finally {
+    addInFlight = false;
+  }
+}
+
+function setupCtxMenu() {
+  const menu = $("ctx-menu");
+  const consoleEl = $("console");
+  consoleEl.addEventListener("contextmenu", (e) => {
+    const sel = String(window.getSelection() || "");
+    if (!sel.trim()) { hideCtxMenu(); return; } // 无选中时保留原生菜单
+    e.preventDefault();
+    menu.hidden = false;
+    // 先显示再夹取,避免菜单超出视口
+    const mw = menu.offsetWidth, mh = menu.offsetHeight;
+    menu.style.left = Math.min(e.clientX, window.innerWidth - mw - 8) + "px";
+    menu.style.top = Math.min(e.clientY, window.innerHeight - mh - 8) + "px";
+  });
+  for (const btn of menu.querySelectorAll("[data-act]")) {
+    btn.addEventListener("click", () => {
+      const sel = String(window.getSelection() || "");
+      hideCtxMenu();
+      if (!sel.trim()) return;
+      if (btn.dataset.act === "insert") insertSelectionToInput(sel).catch((e) => toast(e.message, true));
+      else copyText(sel).then(() => toast("已复制选中文本")).catch(() => toast("复制失败", true));
+    });
+  }
+  document.addEventListener("click", hideCtxMenu);
+  document.addEventListener("keydown", (e) => { if (e.key === "Escape") hideCtxMenu(); });
+  window.addEventListener("scroll", hideCtxMenu, true);
+}
+
+// ---- 配置导入/导出(同事间交换配置) ------------------------------------------
+// 导出走 ui/download-file(宿主弹原生另存为;面板 iframe 无下载权限,浏览器下载会被沙箱拦),
+// 取消/不支持时退到剪贴板。导入用 <input type=file> 读文件,不带 id 逐条 run_config_save 新建,
+// 同名不覆盖不合并——双方各自维护自己的副本。
+
+const CONFIG_EXPORT_FORMAT = "hba-run-configs";
+
+function exportFileName() {
+  const d = new Date();
+  const pad = (n) => String(n).padStart(2, "0");
+  return `hba-run-configs-${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}.json`;
+}
+
+function downloadTextFile(filename, text) {
+  const blob = new Blob([text], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const a = document.createElement("a");
+  a.href = url;
+  a.download = filename;
+  document.body.appendChild(a);
+  a.click();
+  a.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+async function exportConfigs() {
+  // 只导出共享需要的字段:id/时间戳由双方各自生成,避免导入时覆盖对方已有配置
+  const configs = App.configs.map((c) => ({
+    name: c.name,
+    command: c.command,
+    cwd: c.cwd || "",
+    env: c.env || {},
+    previewUrl: c.previewUrl || ""
+  }));
+  if (!configs.length) {
+    toast("暂无配置可导出", true);
+    return;
+  }
+  const json = JSON.stringify({
+    format: CONFIG_EXPORT_FORMAT,
+    version: 1,
+    exportedAt: new Date().toISOString(),
+    configs
+  }, null, 2);
+  const filename = exportFileName();
+  if (window.parent === window || !Bridge.connected) {
+    downloadTextFile(filename, json); // 独立打开:直接触发浏览器下载
+    toast(`已导出 ${configs.length} 条配置`);
+    return;
+  }
+  try {
+    const res = await Bridge.request("ui/download-file", {
+      contents: [{
+        type: "resource",
+        resource: { uri: "file:///" + filename, name: filename, mimeType: "application/json", text: json }
+      }]
+    }, 30000);
+    if (res && res.isError) throw new Error("save cancelled");
+    toast(`已导出 ${configs.length} 条配置`);
+  } catch (e) {
+    await copyText(json);
+    toast("导出未完成,已复制配置 JSON 到剪贴板");
+  }
+}
+
+async function importConfigsFromText(text) {
+  let data;
+  try {
+    data = JSON.parse(text);
+  } catch (e) {
+    throw new Error("不是有效的 JSON 文件");
+  }
+  // 兼容裸数组;标准格式为 { format, version, configs: [] }
+  const list = Array.isArray(data) ? data : data && Array.isArray(data.configs) ? data.configs : null;
+  if (!list) throw new Error("缺少 configs 数组,不是有效的配置文件");
+  if (!list.length) throw new Error("配置文件里没有配置");
+  let count = 0;
+  for (const raw of list) {
+    const name = String((raw && raw.name) || "").trim();
+    const command = String((raw && raw.command) || "").trim();
+    if (!name || !command) continue; // 缺必填字段的条目跳过
+    const envIn = raw.env && typeof raw.env === "object" && !Array.isArray(raw.env) ? raw.env : {};
+    const env = {};
+    for (const [k, v] of Object.entries(envIn)) {
+      if (k && v != null) env[String(k)] = String(v);
+    }
+    await callTool("run_config_save", {
+      name,
+      command,
+      cwd: String(raw.cwd || "").trim(),
+      env,
+      previewUrl: String(raw.previewUrl || "").trim()
+    });
+    count += 1;
+  }
+  if (!count) throw new Error("没有可导入的配置(条目缺少 name/command)");
+  await refreshConfigs();
+  return count;
+}
+
+function setupImportExport() {
+  const fileInput = $("import-file");
+  $("btn-export").addEventListener("click", () => exportConfigs().catch((e) => toast(e.message, true)));
+  $("btn-import").addEventListener("click", () => {
+    if (window.parent === window || !Bridge.connected) {
+      toast("独立模式:无法导入(需连接宿主)", true);
+      return;
+    }
+    fileInput.value = ""; // 重置后才能重复选同一个文件
+    fileInput.click();
+  });
+  fileInput.addEventListener("change", async () => {
+    const file = fileInput.files && fileInput.files[0];
+    if (!file) return;
+    try {
+      const count = await importConfigsFromText(await file.text());
+      toast(`已导入 ${count} 条配置`);
+    } catch (e) {
+      toast("导入失败:" + (e.message || e), true);
+    }
+  });
+}
+
+// ---- 面板状态持久化(B 方案:项目级共享) --------------------------------------
+// UI 状态(选中配置/当前运行/侧栏折叠)经 run_ui_state 工具持久化到
+// <workspace>/.hba/run-ui-state.json:同项目所有会话/窗口的运行面板共享一份
+// 状态,打开面板即恢复。独立模式(未连接宿主)不持久化。
+const UI_STATE_SAVE_DEBOUNCE_MS = 500;
+let uiStateTimer = null;
+let uiStateRestoring = false;
+
+function currentUiState() {
+  return {
+    selectedConfigId: App.selectedConfigId,
+    currentRunId: App.currentRunId,
+    asideCollapsed: document.body.classList.contains("aside-hidden")
+  };
+}
+
+function scheduleUiStateSave() {
+  if (uiStateRestoring || window.parent === window || !Bridge.connected) return;
+  if (uiStateTimer) clearTimeout(uiStateTimer);
+  uiStateTimer = setTimeout(() => {
+    uiStateTimer = null;
+    callTool("run_ui_state", { state: currentUiState() }).catch(() => {});
+  }, UI_STATE_SAVE_DEBOUNCE_MS);
+}
+
+async function loadUiState() {
+  // 失败向上抛:传输类失败由 init 退避重试;「无状态/空」是正常降级,记日志后按 null 继续
+  const res = await callTool("run_ui_state", {});
+  if (res && res.state && typeof res.state === "object") return res.state;
+  console.info("[hba-run] 无已保存的面板状态(首次打开或已清空),按空状态继续");
+  return null;
+}
+
+function applyUiChromeState(saved) {
+  if (typeof saved.asideCollapsed === "boolean") {
+    document.body.classList.toggle("aside-hidden", saved.asideCollapsed);
+  }
+}
+
+async function restoreCurrentRun(runId) {
+  App.currentRunId = runId;
+  if (!App.outputByRun[runId]) App.outputByRun[runId] = { lines: [], since: 0 };
+  try {
+    await fetchOutput(runId);
+  } catch (e) {
+    if (isTransportFailure(e)) throw e; // 传输失败 → 上层调度重试整段 init
+    // 运行记录已滚出历史等业务失败,恢复不了就回落到空控制台
+    App.currentRunId = null;
+  }
+  renderConsole();
+}
+
+// ---- 启动 ------------------------------------------------------------------
+
+function scheduleRefresh() {
+  if (App.refreshTimer) return;
+  App.refreshTimer = setTimeout(() => {
+    App.refreshTimer = null;
+    // 配置列表必须一起刷:Agent 可经 run_config_* 工具改配置,
+    // 服务端 run_config_save/delete/duplicate 都会发 resources/updated
+    Promise.all([refreshConfigs(), refreshRuns()])
+      .then(() => {
+        if (App.currentRunId) return fetchOutput(App.currentRunId);
+      })
+      .catch((e) => console.warn(e));
+  }, 250);
+}
+
+// 无活动进程时配置变更的兜底轮询:宿主不转发 resources/updated 时,
+// 面板也能在数秒内同步 Agent 经工具做的配置改动(见 batch-report 待联测项)。
+const CONFIG_POLL_MS = 5000;
+let lastConfigPollAt = 0;
+
+function pollConfigsThrottled() {
+  const now = Date.now();
+  if (now - lastConfigPollAt < CONFIG_POLL_MS) return;
+  lastConfigPollAt = now;
+  refreshConfigs().catch(() => {});
+}
+
+function startPolling() {
+  if (App.pollTimer) return;
+  App.pollTimer = setInterval(() => {
+    pollConfigsThrottled();
+    const anyRunning = App.runs.some((r) => r.state === "running");
+    if (!anyRunning) return;
+    refreshRuns()
+      .then(() => (App.currentRunId ? fetchOutput(App.currentRunId) : null))
+      .catch(() => {});
+  }, 1200);
+}
+
+// ---- 启动自愈(init 失败退避重试 + 桥看门狗) --------------------------------
+// connect 或任一数据阶段失败都不让面板永久停摆:按 2/4/8/15/30s 退避重试整段
+// init(30s 封顶,之后每 30s 一次),面板存活期间持续自愈;桥请求层连续失败
+// 达阈值(见 Bridge.onBridgeDead)则强制重入,防「桥假死、面板僵尸」。
+const INIT_RETRY_DELAYS_MS = [2000, 4000, 8000, 15000, 30000];
+let initRetryTimer = null;
+let initRetryAttempt = 0;
+let initGeneration = 0; // 每轮 init 递增,作废旧轮结果,防并发重入
+// 渲染闸门:init 期间挂起,savedUi(外观/选中配置)落地后放行;使
+// config_list/status 的网络请求可与 loadUiState 并行先发,渲染等状态。
+let uiStateGate = Promise.resolve();
+
+/** 传输类失败(超时/桥层错误)→ 需重试整段 init;round-trip 成功但工具报业务错 → 降级继续。 */
+function isTransportFailure(e) {
+  if (!e) return false;
+  if (isBridgeUnsupported(e)) return false; // 宿主明确「不支持」,重试无意义
+  if (typeof e.code === "number") return true; // JSON-RPC 层错误(消息送达但被拒)
+  return /bridge 请求超时/.test(String(e.message || ""));
+}
+
+/** 重入前清运行期定时器,防僵尸轮询/旧刷新/旧重试残留。
+ *  uiStateTimer(状态防抖保存)刻意保留:清了会丢最后一次状态保存。 */
+function clearInitTimers() {
+  if (App.pollTimer) { clearInterval(App.pollTimer); App.pollTimer = null; }
+  if (App.refreshTimer) { clearTimeout(App.refreshTimer); App.refreshTimer = null; }
+  if (initRetryTimer) { clearTimeout(initRetryTimer); initRetryTimer = null; }
+}
+
+function scheduleInitRetry(reason) {
+  if (initRetryTimer) return;
+  const delay = INIT_RETRY_DELAYS_MS[Math.min(initRetryAttempt, INIT_RETRY_DELAYS_MS.length - 1)];
+  console.warn("[hba-run] init 失败(" + reason + "), " + delay + "ms 后重试(第 " + (initRetryAttempt + 1) + " 次退避)");
+  initRetryAttempt += 1;
+  initRetryTimer = setTimeout(() => { initRetryTimer = null; runInit(); }, delay);
+}
+
+/**
+ * 单轮宿主初始化,串行跨进程往返压到 2 跳:
+ *   阶段1 Bridge.connect();阶段2 订阅 ∥ 读 UI 状态 ∥ 刷新列表并行发出,
+ *   savedUi 落地即放行渲染闸门,并立刻发起当前运行日志回放。
+ * 任一传输类失败抛给 runInit 调度退避重试。
+ */
+async function initHostData(gen) {
+  const t0 = Date.now();
+  console.debug("[hba-run] init connect ...");
+  const initResult = await Bridge.connect();
+  if (gen !== initGeneration) return; // 已被新一轮 init 取代
+  console.debug("[hba-run] init connect ok +" + (Date.now() - t0) + "ms");
+
+  // hostContext 携带初始主题;之后的变化走 host-context-changed 通知
+  if (initResult && initResult.hostContext && initResult.hostContext.theme) {
+    applyTheme(initResult.hostContext.theme);
+  }
+
+  // 渲染闸门:本轮 savedUi 落地前,refresh* 只发请求、不改状态不渲染
+  let releaseGate;
+  uiStateGate = new Promise((r) => { releaseGate = r; });
+
+  // 三路并行:订阅状态推送 ∥ 读共享面板状态 ∥ 刷新配置与运行列表(其内部已并行)
+  const subscribeP = Bridge.subscribe("ui://run/state");
+  const refreshP = refreshAll();
+  const savedUiP = loadUiState().then((savedUi) => {
+    // savedUi(外观+选中配置)必须先于任何消费 selectedConfigId 的渲染落地
+    if (gen === initGeneration) {
+      uiStateRestoring = true;
+      try {
+        if (savedUi) {
+          applyUiChromeState(savedUi);
+          if (savedUi.selectedConfigId) App.selectedConfigId = savedUi.selectedConfigId;
+        }
+      } finally {
+        uiStateRestoring = false;
+      }
+    }
+    releaseGate();
+    console.debug("[hba-run] init savedUi applied +" + (Date.now() - t0) + "ms");
+    return savedUi;
+  }, (e) => {
+    releaseGate(); // 成败都放行,避免渲染闸门挂死
+    throw e;
+  });
+  // savedUi 一返回即发起当前运行日志回放:restoreCurrentRun 不依赖 refreshAll
+  // (fetchOutput/renderConsole 只读 outputByRun/currentRunId),与渲染并行
+  const restoreP = savedUiP.then(
+    (savedUi) => (savedUi && savedUi.currentRunId ? restoreCurrentRun(savedUi.currentRunId) : null),
+    () => null // loadUiState 的错误由 savedUiP 自身上报,这里不重复
+  );
+
+  const settled = await Promise.allSettled([savedUiP, subscribeP, refreshP, restoreP]);
+  if (gen !== initGeneration) return; // 旧轮结果作废,新一轮已接管
+  const stages = ["loadUiState", "subscribe", "refreshAll", "restoreCurrentRun"];
+  for (let i = 0; i < settled.length; i++) {
+    const r = settled[i];
+    if (r.status !== "rejected") continue;
+    if (isTransportFailure(r.reason)) throw r.reason; // 传输失败 → 退避重试整段 init
+    console.warn("[hba-run] init " + stages[i] + " 非传输失败,按降级继续:", r.reason);
+  }
+  console.debug("[hba-run] init data ready +" + (Date.now() - t0) + "ms");
+}
+
+/** 跑一轮 init:成功收尾启动轮询;失败清定时器并按退避调度重试。
+ *  重试定时器与看门狗强制重入都收敛到这里,靠 initGeneration 防并发重入。 */
+function runInit() {
+  clearInitTimers();
+  const gen = ++initGeneration;
+  return initHostData(gen).then(() => {
+    if (gen !== initGeneration) return;
+    initRetryAttempt = 0; // 成功后退避归零
+    startPolling();
+    Bridge.sendSizeChanged();
+    console.debug("[hba-run] init done");
+  }, (e) => {
+    if (gen !== initGeneration) return; // 旧轮失败,已被新一轮接管
+    console.warn("[hba-run] init 失败:", e);
+    clearInitTimers();
+    scheduleInitRetry((e && e.message) || String(e));
+  });
+}
+
+async function init() {
+  // 启动先落一个系统主题兜底;连上宿主后由 hostContext 覆盖
+  applyTheme(systemTheme());
+  if (window.matchMedia) {
+    const mq = window.matchMedia("(prefers-color-scheme: light)");
+    if (mq.addEventListener) {
+      mq.addEventListener("change", () => { if (!Bridge.connected) applyTheme(systemTheme()); });
+    }
+  }
+
+  // 事件绑定(一次性:init 重试只重跑数据阶段,不重复绑定)
+  $("btn-new").addEventListener("click", () => openModal(null));
+  $("btn-del").addEventListener("click", () => deleteConfig().catch((e) => toast(e.message, true)));
+  $("btn-dup").addEventListener("click", () => duplicateConfig().catch((e) => toast(e.message, true)));
+  $("btn-clear").addEventListener("click", clearConsole);
+  $("btn-copy").addEventListener("click", () => copyConsole().catch((e) => console.warn(e)));
+  // 标题区:下拉框切换配置(换日志)+ 按运行态显示的 启动 / 重启 / 停止
+  $("cfg-select").addEventListener("change", (e) => {
+    const id = e.target.value;
+    if (id) selectConfig(id).catch((err) => toast(err.message, true));
+  });
+  $("btn-h-start").addEventListener("click", () => {
+    if (App.selectedConfigId) startRunOf(App.selectedConfigId).catch((e) => toast(e.message, true));
+  });
+  $("btn-h-restart").addEventListener("click", () => {
+    if (App.selectedConfigId) restartConfig(App.selectedConfigId).catch((e) => toast(e.message, true));
+  });
+  $("btn-h-stop").addEventListener("click", () => {
+    if (App.selectedConfigId) stopConfig(App.selectedConfigId).catch((e) => toast(e.message, true));
+  });
+  $("btn-aside-hide").addEventListener("click", () => {
+    document.body.classList.add("aside-hidden");
+    scheduleUiStateSave();
+  });
+  $("btn-aside-show").addEventListener("click", () => {
+    document.body.classList.remove("aside-hidden");
+    scheduleUiStateSave();
+  });
+  $("modal-save").addEventListener("click", () => saveModal());
+  $("modal-cancel").addEventListener("click", closeModal);
+  $("modal-close").addEventListener("click", closeModal);
+  $("cfg-modal").addEventListener("click", (e) => { if (e.target === $("cfg-modal")) closeModal(); });
+  document.addEventListener("keydown", (e) => {
+    if (e.key === "Escape" && !$("cfg-modal").hidden) closeModal();
+  });
+  setupCtxMenu();
+  setupImportExport();
+  setupConsoleScroll();
+
+  // 先落一次标题区状态(无配置=下拉占位+按钮禁用),避免首帧三个按钮齐亮
+  renderConsoleHead();
+
+  if (window.parent === window) {
+    return; // standalone preview mode: no host bridge
+  }
+
+  // 宿主监听器只注册一次:init 重试/看门狗重入不会重复挂载
+  Bridge.onThemeChange((ctx) => { if (ctx && ctx.theme) applyTheme(ctx.theme); });
+
+  Bridge.onResourceUpdate(() => {
+    scheduleRefresh();
+    if (App.currentRunId) fetchOutput(App.currentRunId).catch(() => {});
+    startPolling();
+  });
+  Bridge.onTeardown(() => {
+    clearInitTimers(); // 含重试定时器:面板被卸载后不再自愈重试
+  });
+  // 桥看门狗:请求层连续失败达阈值 → 强制重新 init(防「桥假死、面板僵尸」)
+  Bridge.onBridgeDead(() => {
+    console.warn("[hba-run] 桥连续请求失败达阈值,强制重新初始化");
+    runInit();
+  });
+  window.addEventListener("resize", () => Bridge.sendSizeChanged());
+
+  // 数据初始化在后台自愈循环里跑:失败按退避重试,不阻塞面板首帧
+  return runInit();
+}
+
+init().catch((e) => {
+  // No header status badge any more; surface init errors in the console.
+  console.error(e);
+});
+</script>
+</body>
+</html>
