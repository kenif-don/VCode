+  // 两者都没有才切空日志,不残留其他配置的输出。
+  const run = App.runs.filter((r) => r.configId === id).pop();
+  if (run) {
+    if (run.runId !== App.currentRunId) selectRun(run.runId);
+    scheduleUiStateSave();
+    return;
+  }
+  try {
+    const res = await callTool("run_history", { limit: 50 });
+    // 等待期间用户可能已切走:只在仍选中该配置时应用,避免旧查询覆盖新选择
+    if (App.selectedConfigId !== id) return;
+    const entry = (res.history || []).find((h) => h.configId === id);
+    if (entry) {
+      selectRun(entry.id);
+      scheduleUiStateSave();
+      return;
+    }
+  } catch (e) {
+    /* 历史不可用时按无日志处理 */
+  }
+  if (App.selectedConfigId !== id) return;
+  if (App.currentRunId) {
+    App.currentRunId = null;
+    renderConsole();
+    scheduleUiStateSave();
+  }
+  scheduleUiStateSave();
