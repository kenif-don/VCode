+
+<script>
+"use strict";
+/* ===========================================================================
+ * bridge 适配层(独立块,便于集成期替换)
+ * 协议来源:对 VCode 官方 pdf-plugin 的 .zcode-plugin/plugin.json + dist/ui/panel.html
+ * 反推得到的 MCP-over-postMessage 桥:
+ *   - 面板 iframe 是一个 MCP client,JSON-RPC 2.0 消息原样经 window.parent.postMessage
+ *     发往宿主,window "message" 事件收取(e.source 必须是 window.parent);
+ *   - 握手:ui/initialize(protocolVersion "2026-01-26")-> ui/notifications/initialized
+ *     (不要发 MCP initialize,宿主回 Method not found);
+ *   - ui/initialize 的响应带 hostContext(含 theme),主题变化由
+ *     ui/notifications/host-context-changed 通知推送(部分增量,可能只含 theme);
+ *   - 之后走标准 MCP:tools/call、resources/read、resources/subscribe,
+ *     服务端以 notifications/resources/updated 推送状态变化;
+ *   - 日志添加到对话优先 ui/insert-input-text(VCode 扩展,文本进输入框不发送),
+ *     老宿主降级 ui/update-model-context(插件上下文附到对话输入区);
+ *     ui/message(以用户身份发送,宿主可能弹确认框)已不再使用。
+ * ======================================================================== */
+const Bridge = (() => {
+  const pending = new Map();
+  const resourceListeners = new Set();
+  const teardownListeners = new Set();
+  const themeListeners = new Set();
+  let nextId = 1;
+  let connected = false;
+
+  window.addEventListener("message", (event) => {
+    if (event.source !== window.parent) return;
+    const msg = event.data;
+    if (!msg || msg.jsonrpc !== "2.0") return;
+    if (msg.id !== undefined && msg.id !== null && (msg.result !== undefined || msg.error !== undefined)) {
+      const entry = pending.get(msg.id);
+      if (!entry) return;
+      pending.delete(msg.id);
+      clearTimeout(entry.timer);
+      if (msg.error) {
+        const err = new Error(msg.error.message || "JSON-RPC error");
+        if (typeof msg.error.code === "number") err.code = msg.error.code;
+        entry.reject(err);
+      } else entry.resolve(msg.result);
+      return;
+    }
+    if (typeof msg.method === "string") {
+      if (msg.method === "notifications/resources/updated") {
+        for (const cb of resourceListeners) { try { cb(msg.params || {}); } catch (e) { console.error(e); } }
+      } else if (msg.method === "ui/notifications/request-teardown") {
+        for (const cb of teardownListeners) { try { cb(); } catch (e) { console.error(e); } }
+      } else if (msg.method === "ui/notifications/host-context-changed") {
+        // params 是部分上下文增量,只有主题变化时就只含 theme
+        const ctx = msg.params || {};
+        if (ctx.theme) {
+          for (const cb of themeListeners) { try { cb(ctx); } catch (e) { console.error(e); } }
+        }
+      }
+    }
+  });
+
+  function request(method, params, timeoutMs = 15000) {
+    return new Promise((resolve, reject) => {
+      const id = nextId++;
+      const timer = setTimeout(() => {
+        pending.delete(id);
+        reject(new Error("bridge 请求超时: " + method));
+      }, timeoutMs);
+      pending.set(id, { resolve, reject, timer });
+      window.parent.postMessage({ jsonrpc: "2.0", id, method, params: params || {} }, "*");
+    });
+  }
+
+  function notify(method, params) {
+    window.parent.postMessage({ jsonrpc: "2.0", method, params: params || {} }, "*");
+  }
+
+  async function connect() {
+    // The view<->host channel does NOT speak MCP "initialize" (the host replies
+    // "Method not found"); the handshake is exactly: ui/initialize request
+    // (UI protocol 2026-01-26) -> ui/notifications/initialized.
+    const result = await request("ui/initialize", {
+      appInfo: { name: "hba-run", version: "0.1.1" },
+      appCapabilities: { tools: { listChanged: false }, availableDisplayModes: ["inline", "fullscreen"] },
+      protocolVersion: "2026-01-26"
+    }, 5000);
+    notify("ui/notifications/initialized", {});
+    connected = true;
+    return result;
+  }
+
+  async function callTool(name, args) {
+    const result = await request("tools/call", { name, arguments: args || {} }, 30000);
+    if (result && result.isError) {
+      const text = (result.content || []).map((c) => c.text || "").join("\n");
+      throw new Error(text || ("工具执行失败: " + name));
+    }
+    return result && result.structuredContent !== undefined ? result.structuredContent : result;
+  }
+
+  async function readResource(uri) {
+    const result = await request("resources/read", { uri });
+    return result && result.contents ? result.contents[0] : null;
+  }
+
+  async function subscribe(uri) {
+    try { await request("resources/subscribe", { uri }); } catch (e) { console.warn(e); }
+  }
+
+  function onResourceUpdate(cb) { resourceListeners.add(cb); return () => resourceListeners.delete(cb); }
+  function onTeardown(cb) { teardownListeners.add(cb); return () => teardownListeners.delete(cb); }
+  function onThemeChange(cb) { themeListeners.add(cb); return () => themeListeners.delete(cb); }
+
+  function sendSizeChanged() {
+    const width = Math.ceil(window.innerWidth);
+    const height = Math.ceil(document.documentElement.getBoundingClientRect().height);
+    notify("ui/notifications/size-changed", { width, height });
+  }
+
+  return {
+    connect, request, notify, callTool, readResource, subscribe,
+    onResourceUpdate, onTeardown, onThemeChange, sendSizeChanged,
+    get connected() { return connected; }
+  };
+})();
+
+/* ===========================================================================
+ * 应用逻辑
+ * ======================================================================== */
+const $ = (id) => document.getElementById(id);
+
+const App = {
+  configs: [],
+  runs: [],
+  selectedConfigId: null,
+  currentRunId: null,
+  outputByRun: Object.create(null), // runId -> { lines: [], since: 0 }
+  editingConfigId: null, // null = 弹窗处于「新建」模式;否则为被编辑配置 id
+  pollTimer: null,
+  refreshTimer: null,
+  consoleRenderedRun: null // 当前 #console DOM 对应的 runId(增量追加的同步标记)
+};
+
+// 独立打开(无宿主)时直接拒绝工具调用,给出可读错误而不是桥超时。
+function callTool(name, args) {
+  if (window.parent === window) {
+    return Promise.reject(new Error("独立模式:未连接宿主,无法调用 " + name));
+  }
+  return Bridge.callTool(name, args);
+}
+
+function escapeHtml(s) {
+  return String(s).replace(/[&<>"']/g, (c) => ({
+    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
+  }[c]));
+}
+
+function parseEnvLines(text) {
+  const env = {};
+  for (const raw of String(text || "").split("\n")) {
+    const line = raw.trim();
+    if (!line || line.startsWith("#")) continue;
+    const i = line.indexOf("=");
+    if (i <= 0) continue;
+    env[line.slice(0, i).trim()] = line.slice(i + 1);
+  }
+  return env;
+}
+
+function envToLines(env) {
+  return Object.entries(env || {}).map(([k, v]) => k + "=" + v).join("\n");
+}
+
+// ---- ANSI 色码解析 --------------------------------------------------------
+// 进程输出(vite/chalk 等)常带 SGR 色码,直接当文本渲染会显示成 [31m 这类乱码;
+// 这里解析成带内联样式的 span,其余转义序列一律剥掉。调色板随主题切换。
+const ANSI_PALETTE = {
+  // 与 VCode 内置终端同款(--color-terminal-* 的 zai-dark / zai-light 值)
+  dark: ["#363636", "#ff5c5c", "#46bf72", "#ff8a30", "#4099ff", "#7b5ce5", "#42c8c8", "#adadad",
+         "#747474", "#ff9999", "#87d9a4", "#ffb26b", "#80beff", "#a888f2", "#8ee5e5", "#f8f8f8"],
+  light: ["#5c5c5c", "#e03131", "#1e8a3e", "#e07b00", "#0b7fff", "#9e77ed", "#0aa7a7", "#adadad",
+          "#888888", "#e03131", "#1e8a3e", "#e07b00", "#0066dd", "#9e77ed", "#0aa7a7", "#0d0d0d"]
+};
+
+function ansiPalette() {
+  return document.documentElement.dataset.theme === "light" ? ANSI_PALETTE.light : ANSI_PALETTE.dark;
+}
+
+function ansiColor256(n) {
+  if (n < 16) return ansiPalette()[n];
+  if (n >= 236) { const g = 8 + (n - 236) * 10; return `rgb(${g},${g},${g})`; }
+  n -= 16;
+  const f = (v) => (v ? 55 + v * 40 : 0);
+  return `rgb(${f(Math.floor(n / 36))},${f(Math.floor((n % 36) / 6))},${f(n % 6)})`;
+}
+
+function stripAnsi(s) {
+  return String(s)
+    .replace(/\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)?/g, "")
+    .replace(/\x1b\[[0-9;:?]*[A-Za-z]/g, "")
+    .replace(/\x1b[@-Z\\-_]/g, "");
+}
+
+function ansiToHtml(raw) {
+  const text = String(raw);
+  let out = "";
+  let last = 0;
+  let fg = "", bg = "", bold = false, dim = false, italic = false, underline = false;
+  const flush = (end) => {
+    if (end <= last) return;
+    const chunk = escapeHtml(text.slice(last, end)).replace(/\x1b/g, "");
+    const st = [];
+    if (fg) st.push("color:" + fg);
+    if (bg) st.push("background:" + bg);
+    if (bold) st.push("font-weight:600");
+    if (dim) st.push("opacity:.65");
+    if (italic) st.push("font-style:italic");
+    if (underline) st.push("text-decoration:underline");
+    out += st.length ? '<span style="' + st.join(";") + '">' + chunk + "</span>" : chunk;
+  };
+  const applySgr = (params) => {
+    const nums = (params || "0").split(";").map((x) => (x === "" ? 0 : parseInt(x, 10) || 0));
+    for (let i = 0; i < nums.length; i++) {
+      const c = nums[i];
+      if (c === 0) { fg = bg = ""; bold = dim = italic = underline = false; }
+      else if (c === 1) bold = true;
+      else if (c === 2) dim = true;
+      else if (c === 3) italic = true;
+      else if (c === 4) underline = true;
+      else if (c === 22) { bold = dim = false; }
+      else if (c === 23) italic = false;
+      else if (c === 24) underline = false;
+      else if (c >= 30 && c <= 37) fg = ansiPalette()[c - 30];
+      else if (c === 39) fg = "";
+      else if (c >= 40 && c <= 47) bg = ansiPalette()[c - 40];
+      else if (c === 49) bg = "";
+      else if (c >= 90 && c <= 97) fg = ansiPalette()[c - 90 + 8];
+      else if (c >= 100 && c <= 107) bg = ansiPalette()[c - 100 + 8];
+      else if (c === 38 || c === 48) {
+        let col = "";
+        if (nums[i + 1] === 5) { col = ansiColor256(nums[i + 2] || 0); i += 2; }
+        else if (nums[i + 1] === 2) {
+          col = `rgb(${nums[i + 2] || 0},${nums[i + 3] || 0},${nums[i + 4] || 0})`;
+          i += 4;
+        }
+        if (col) { if (c === 38) fg = col; else bg = col; }
+      }
+    }
+  };
+  const re = /\x1b\[([0-9;:?]*)m|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)?|\x1b\[[0-9;:?]*[A-Za-z]|\x1b[@-Z\\-_]/g;
+  let m;
+  while ((m = re.exec(text))) {
+    flush(m.index);
+    if (m[1] !== undefined) applySgr(m[1]);
+    last = re.lastIndex;
+  }
+  flush(text.length);
+  return out;
+}
+
+function toast(msg, isErr) {
+  const el = $("toast");
+  el.textContent = msg;
+  el.className = "toast show" + (isErr ? " err" : "");
+  clearTimeout(toast._t);
+  toast._t = setTimeout(() => { el.className = "toast"; }, 2800);
+}
+
+// ---- 主题 ------------------------------------------------------------------
+
+function applyTheme(theme) {
+  document.documentElement.dataset.theme = theme === "light" ? "light" : "dark";
+  renderConsole(); // ANSI 调色板随主题切换,日志重上色
+}
+
+function systemTheme() {
+  return (window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches)
+    ? "light" : "dark";
+}
+
+// ---- 渲染 ------------------------------------------------------------------
+
+/** 该配置当前是否有运行中的 run(行内 ▶/■ 按钮的启停依据)。 */
+function runningRunOf(configId) {
+  return App.runs.find((r) => r.configId === configId && r.state === "running") || null;
+}
+
+/** 标题区:配置下拉框(选中项即标题)+ 按运行态切换 启动 / 重启+停止。 */
+function renderConsoleHead() {
+  const sel = $("cfg-select");
+  const prev = App.selectedConfigId || "";
+  sel.innerHTML = App.configs.length
+    ? App.configs.map((c) => `<option value="${escapeHtml(c.id)}">${escapeHtml(c.name)}</option>`).join("")
+    : '<option value="">暂无配置</option>';
+  sel.value = prev;
+  if (sel.value !== prev) sel.selectedIndex = 0;
+  const has = !!App.selectedConfigId;
+  const running = has && !!runningRunOf(App.selectedConfigId);
+  $("btn-h-start").hidden = running;
+  $("btn-h-restart").hidden = !running;
+  $("btn-h-stop").hidden = !running;
+  $("btn-h-start").disabled = !has;
+  $("btn-h-restart").disabled = !has;
+  $("btn-h-stop").disabled = !has;
+}
+
+// ---- 配置列表拖动排序 --------------------------------------------------------
+// 按住行(操作按钮除外)上下拖动即调序,松手经 run_config_reorder 持久化;
+// 4px 阈值区分点击/双击与拖动,拖动只在 mousemove 超过阈值后开始。
+
+function persistConfigOrder(ids) {
+  callTool("run_config_reorder", { configIds: ids }).then(() => {
+    // 本地同步顺序,免等资源刷新;失败才回读服务端真实顺序
+    App.configs = ids.map((id) => App.configs.find((c) => c.id === id)).filter(Boolean);
+    renderConfigs();
+    renderConsoleHead();
+  }).catch((e) => {
+    toast("保存顺序失败:" + (e.message || e), true);
+    refreshConfigs().catch(() => {});
+  });
+}
+
+function beginConfigDrag(e, el) {
+  if (e.button !== 0) return;
+  if (e.target.closest("button")) return; // 行内操作按钮不触发拖动
+  e.preventDefault(); // 避免拖动过程选中文本
+  const startY = e.clientY;
+  let started = false;
+
+  const onMove = (ev) => {
+    if (!started) {
+      if (Math.abs(ev.clientY - startY) < 4) return;
+      started = true;
+      el.classList.add("dragging");
+    }
+    ev.preventDefault();
+    const container = $("config-items");
+    const siblings = [...container.querySelectorAll(".config-item")].filter((n) => n !== el);
+    let target = null;
+    for (const other of siblings) {
+      const r = other.getBoundingClientRect();
+      if (ev.clientY < r.top + r.height / 2) {
+        target = other;
+        break;
+      }
+    }
+    if (target) {
+      if (el.nextElementSibling !== target) container.insertBefore(el, target);
+    } else if (container.lastElementChild !== el) {
+      container.appendChild(el);
+    }
+  };
+  const onUp = () => {
+    document.removeEventListener("mousemove", onMove);
+    document.removeEventListener("mouseup", onUp);
+    window.removeEventListener("blur", onUp);
+    if (!started) return;
+    el.classList.remove("dragging");
+    const ids = [...$("config-items").querySelectorAll(".config-item")].map((n) => n.dataset.id);
+    const unchanged = ids.join("\n") === App.configs.map((c) => c.id).join("\n");
+    if (!unchanged) persistConfigOrder(ids);
+  };
+  document.addEventListener("mousemove", onMove);
+  document.addEventListener("mouseup", onUp);
