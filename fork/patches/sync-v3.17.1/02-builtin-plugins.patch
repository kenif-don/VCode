+  if (!text) return;
+  await copyText(text);
+}
+
+function clearConsole() {
+  if (!App.currentRunId) return;
+  const view = App.outputByRun[App.currentRunId];
+  // 清空只是清「我的视图」:必须保留 since 游标,否则下一次拉取会把
+  // 服务端环形缓冲区从头(seq 1)整个拉回来,表现为「清空无效」。
+  App.outputByRun[App.currentRunId] = { lines: [], since: view ? view.since : 0 };
