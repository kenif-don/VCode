+  for (const r of App.runs) {
+    if (r.state === "exited" && !r.stopped && !r.spawnError && r.configId && !previewShown.has(r.runId)) {
+      previewShown.add(r.runId);
+      const c = App.configs.find((x) => x.id === r.configId);
+      if (c && c.previewUrl) openPreview(c.previewUrl);
+    }
+  }
