+
+async function refreshConfigs() {
+  const res = await callTool("run_config_list", {});
+  // 请求已先发;状态变更与渲染等 savedUi(选中配置)落地后再做,防竞态
+  await uiStateGate;
+  const configs = res.configs || [];
+  const changed = JSON.stringify(configs) !== JSON.stringify(App.configs);
+  App.configs = configs;
+  const prevSelected = App.selectedConfigId;
+  if (App.selectedConfigId && !App.configs.some((c) => c.id === App.selectedConfigId)) {
+    App.selectedConfigId = null;
+  }
+  if (!App.selectedConfigId && App.configs.length) {
+    App.selectedConfigId = App.configs[0].id;
+  }
+  // 兜底轮询会高频调用本函数;数据没变就不重建 DOM,避免打断 hover/焦点
+  if (changed || prevSelected !== App.selectedConfigId) renderConfigs();
+}
+
+async function refreshRuns() {
+  const res = await callTool("run_status", {});
+  await uiStateGate; // 同 refreshConfigs:渲染等 savedUi 落地
+  App.runs = res.runs || [];
+  // 运行态变化会翻转行内 ▶/■ 的可用性,配置列表也要重绘
+  renderConfigs();
+  maybeAutoPreview();
+}
+
+async function fetchOutput(runId) {
+  const view = App.outputByRun[runId] || (App.outputByRun[runId] = { lines: [], since: 0 });
+  const res = await callTool("run_output", { runId, since: view.since });
+  const newLines = res.lines || [];
+  let truncated = false;
+  if (newLines.length) {
+    view.lines.push(...newLines);
+    if (view.lines.length > 5000) {
+      view.lines.splice(0, view.lines.length - 5000);
+      truncated = true;
+    }
+  }
+  view.since = res.nextSince !== undefined ? res.nextSince : view.since;
+  if (App.currentRunId !== runId) return;
+  // 没有新行时完全不碰 DOM:轮询每 1.2s 一次,重建会打断用户的选择
+  if (truncated) renderConsole();
+  else appendConsoleLines(newLines);
+}
+
+async function deleteConfig() {
+  if (!App.selectedConfigId) return;
+  if (!confirm("确认删除该运行配置?历史记录会保留。")) return;
+  await callTool("run_config_delete", { configId: App.selectedConfigId });
+  App.selectedConfigId = null;
+  await refreshConfigs();
+  scheduleUiStateSave();
+}
+
+async function duplicateConfig() {
+  if (!App.selectedConfigId) return;
+  const res = await callTool("run_config_duplicate", { configId: App.selectedConfigId });
+  if (res.config) App.selectedConfigId = res.config.id;
+  await refreshConfigs();
+  scheduleUiStateSave();
+}
+
+async function startRunOf(configId) {
+  const res = await callTool("run_start", { configId });
+  if (res.run) {
+    App.selectedConfigId = configId;
+    selectRun(res.run.runId);
+  }
+  await refreshRuns();
+}
+
+async function stopConfig(configId) {
+  const run = runningRunOf(configId);
+  if (!run) return;
+  await stopRun(run.runId);
+}
+
+async function stopRun(runId) {
+  // 失败直接抛出,由调用方统一 toast,避免重复提示
+  await callTool("run_stop", { runId });
+  // 停止是异步生效的,稍等后刷新一次即可翻转按钮状态
