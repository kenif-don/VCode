+      properties: { runId: { type: "string", description: "Optional run id; omit for all runs." } },
+      additionalProperties: false
+    },
+    readOnly: true,
+    handler: async ({ runId }) => {
+      if (runId) {
+        const run = runs.get(runId);
+        if (!run) return fail(`run not found: ${runId}`);
