+    box.innerHTML = '<div class="empty">暂无配置,点「＋」创建</div>';
+    $("btn-dup").disabled = true;
+    $("btn-del").disabled = true;
+    return;
+  }
+  box.innerHTML = App.configs.map((c) => {
+    const running = !!runningRunOf(c.id);
+    return `
+    <div class="config-item ${c.id === App.selectedConfigId ? "selected" : ""}" data-id="${escapeHtml(c.id)}">
