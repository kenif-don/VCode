+
+function consoleLineEl(l) {
+  const div = document.createElement("div");
+  div.className = "l-" + (l.stream || "stdout");
+  div.innerHTML = ansiToHtml(l.text);
+  return div;
+}
+
+/**
+ * 日志区的「磁性跟随」规则(自动,无开关):
+ *  - 滚动条贴底 → 自动跟随新输出滚到底;用户上翻后 → 保持位置不被拉回,回到底部自动恢复;
+ *  - 有未收起的选区(正在拖选/准备右键发送)时不滚动,避免拖拽终点被带走;
+ *  - 日志 DOM 增量追加而非整体重建,选区锚点不会中途被毁。
+ */
+function isConsoleNearBottom(box) {
+  return box.scrollHeight - box.scrollTop - box.clientHeight <= 40;
+}
+
+function updateToBottomBtn(box) {
+  $("btn-to-bottom").hidden = isConsoleNearBottom(box);
+}
+
+function consoleFollowAllowed(box) {
+  const sel = window.getSelection();
+  if (sel && !sel.isCollapsed) return false;
+  return isConsoleNearBottom(box);
+}
+
+function renderConsole() {
+  const box = $("console");
+  const view = App.outputByRun[App.currentRunId];
+  App.consoleRenderedRun = App.currentRunId;
+  if (!view || !view.lines.length) {
+    box.innerHTML = '<div class="empty">' +
+      (App.currentRunId ? "暂无输出" : "选择配置查看输出") + "</div>";
+    updateToBottomBtn(box);
+    return;
+  }
+  const frag = document.createDocumentFragment();
+  for (const l of view.lines) frag.appendChild(consoleLineEl(l));
+  box.innerHTML = "";
+  box.appendChild(frag);
+  box.scrollTop = box.scrollHeight;
+  updateToBottomBtn(box);
+}
+
+/** 增量追加新行。整体重建会毁掉进行中的选区(表现为"选择从日志开头起选"),必须避免。 */
+function appendConsoleLines(newLines) {
+  const box = $("console");
+  if (App.consoleRenderedRun !== App.currentRunId) {
+    renderConsole(); // DOM 与当前运行不同步(切运行/清空后),退回整体渲染
+    return;
+  }
+  if (!newLines || !newLines.length) return;
+  const follow = consoleFollowAllowed(box);
+  const emptyEl = box.querySelector(".empty");
+  if (emptyEl) box.removeChild(emptyEl);
+  for (const l of newLines) box.appendChild(consoleLineEl(l));
+  if (follow) box.scrollTop = box.scrollHeight;
+  updateToBottomBtn(box);
+}
+
+/** 「回到底部」浮动按钮:上翻时出现,点击跳回底部后隐藏,磁性跟随随之恢复。 */
+function setupConsoleScroll() {
+  const box = $("console");
+  box.addEventListener("scroll", () => updateToBottomBtn(box), { passive: true });
+  $("btn-to-bottom").addEventListener("click", () => {
+    box.scrollTop = box.scrollHeight;
+    updateToBottomBtn(box);
+  });
+}
+
+const previewShown = new Set();
