+
+  function toggleGrid() {
+    state.grid = !state.grid;
+    $("screen-canvas").classList.toggle("grid-on", state.grid);
+    $("btn-grid-toggle").classList.toggle("on", state.grid);
+    scheduleSaveLayout();
+  }
+
+  // ==================================================================
+  // 「生成应用」弹层 (FR-2-1)
+  // ==================================================================
+  function openGenDialog() {
+    $("gen-overlay").classList.add("open");
+    $("gen-msg").textContent = "就绪";
+    $("gen-msg").className = "";
+    $("gen-progress-fill").style.width = "0%";
+    setTimeout(function () { $("gen-prompt").focus(); }, 0);
+  }
+  function closeGenDialog() { $("gen-overlay").classList.remove("open"); }
+
+  async function doGenerate() {
+    var prompt = $("gen-prompt").value.trim();
+    if (!prompt) { $("gen-msg").textContent = "请先输入需求描述"; $("gen-msg").className = "err"; return; }
+    var format = $("gen-format").value;
+    var screenCount = parseInt($("gen-count").value, 10) || 3;
+    $("btn-gen-start").disabled = true;
+    $("gen-msg").className = "";
+    $("gen-msg").textContent = "生成中…";
+    $("gen-progress-fill").style.width = "0%";
+    try {
+      var res = await bridge.callTool("uigen_generate", {
+        prompt: prompt, format: format, screenCount: screenCount
+      });
+      if (res && res.ok && Array.isArray(res.screens) && res.screens.length) {
+        state.screens = res.screens;      // 服务端已直接写盘(screens/ + index.json)
+        state.cards = {};                 // 新一轮生成重新排布
+        state.selected = 0;
+        $("gen-progress-fill").style.width = "100%";
+        $("gen-msg").textContent = "完成 · 引擎 " + (res.engine || "?") + " · " + res.screens.length + " 屏已写盘";
+        renderTree();
+        renderCards();
+        closeGenDialog();
+        toast("已生成 " + res.screens.length + " 屏(已写盘)");
+        scheduleSaveLayout();
+      } else {
+        $("gen-msg").textContent = "生成失败:" + (res && res.error ? res.error : "未知错误");
+        $("gen-msg").className = "err";
+      }
+    } catch (e) {
+      $("gen-msg").textContent = "生成失败:" + e.message;
+      $("gen-msg").className = "err";
+    } finally {
+      $("btn-gen-start").disabled = false;
+    }
+  }
+
+  // ==================================================================
+  // 导入 / 导出 (FR-2-6 / FR-2-8)
+  // ==================================================================
+  async function doImport() {
+    var dir = window.prompt("要导入的本地目录(含 *.html):");
+    if (!dir) return;
+    try {
+      var res = await bridge.callTool("uigen_import_dir", { dir: dir });
+      if (res && res.ok) {
+        toast("已导入 " + res.imported + " 个原型到 screens/(已落盘)");
+        await reloadScreens();
+        scheduleSaveLayout();
+      } else {
+        toast("导入失败:" + (res && res.error ? res.error : "未知错误"), true);
+      }
+    } catch (e) {
+      toast("导入失败:" + e.message, true);
+    }
+  }
+
+  async function doExport() {
+    if (!state.screens.length) { toast("screens/ 为空,无产物可导出", true); return; }
+    try {
+      var res = await bridge.callTool("uigen_export", {});
+      if (res && res.ok) {
+        toast("已导出 " + (res.files || []).length + " 个文件 → " + res.targetDir);
+      } else {
+        toast("导出失败:" + (res && res.error ? res.error : "未知错误"), true);
+      }
+    } catch (e) {
+      toast("导出失败:" + e.message, true);
+    }
+  }
+
+  // ==================================================================
+  // 全屏顺序播放 (FR-2-5 改造) — 沿用步进逻辑,壳换成全屏 overlay
+  // ==================================================================
+  function playFrame() { return $("preview-frame"); }
+
+  function renderPlayScreen(i) {
+    var s = state.screens[i];
+    if (!s) return;
+    $("play-title").textContent = s.name || s.id;
+    $("play-pos").textContent = (i + 1) + "/" + state.screens.length;
+    var frame = playFrame();
+    try {
+      frame.srcdoc = stripScripts(s.html) || "<!doctype html><html><body>该屏幕没有 HTML 产物</body></html>";
+    } catch (e) { /* 播放预览失败不拖垮面板 */ }
+  }
+
+  function syncPlayTo(i) {
+    state.playIndex = i;
+    renderPlayScreen(i);
+  }
+
+  function playStep(delta) {
+    if (!state.screens.length) return;
+    var next = state.playIndex + delta;
+    if (next < 0) next = state.screens.length - 1;
+    if (next >= state.screens.length) next = 0;
+    syncPlayTo(next);
+  }
+
+  function setPlaying(on) {
+    state.playing = on;
+    $("btn-play-toggle").textContent = on ? "⏸ 暂停" : "▶ 继续";
+    if (state.playTimer) { clearInterval(state.playTimer); state.playTimer = null; }
+    if (on) state.playTimer = setInterval(function () { playStep(1); }, 2200);
+  }
+
+  function openPlay() {
+    if (!state.screens.length) { toast("没有可播放的屏幕", true); return; }
+    $("play-overlay").classList.add("open");
+    syncPlayTo(state.selected >= 0 ? state.selected : 0);
+    setPlaying(true);
+  }
+
+  function closePlay() {
+    setPlaying(false);
+    $("play-overlay").classList.remove("open");
+    try { playFrame().removeAttribute("srcdoc"); } catch (e) { /* noop */ }
+  }
+
+  // ==================================================================
+  // 侧栏折叠
+  // ==================================================================
+  function applySidebar() {
+    $("sidebar").classList.toggle("collapsed", state.sidebarCollapsed);
+    $("btn-sidebar-open").classList.toggle("show", state.sidebarCollapsed);
+  }
+  function toggleSidebar() {
+    state.sidebarCollapsed = !state.sidebarCollapsed;
+    applySidebar();
+    scheduleSaveLayout();
+  }
+
+  // ==================================================================
+  // 格式切换 — html=iframe 实时预览;jsx/vue=代码(实时渲染列二期)
+  // ==================================================================
+  var FORMAT_CYCLE = ["html", "jsx", "vue"];
+  function cycleFormat() {
+    var idx = FORMAT_CYCLE.indexOf(state.format);
+    state.format = FORMAT_CYCLE[(idx + 1) % FORMAT_CYCLE.length];
+    renderCards();
+    toast("卡片内容:" + state.format.toUpperCase() + (state.format !== "html" ? "(实时渲染列二期)" : ""));
+    scheduleSaveLayout();
+  }
+
+  // ==================================================================
+  // 顶栏项目信息 — uigen_canvas_get 返回的 workspace;拿不到显示 —
+  // ==================================================================
+  function setWorkspace(ws) {
+    if (ws && ws.name) {
+      $("proj-name").textContent = ws.name;
+      $("proj-path").textContent = ws.root || "";
+      $("proj-path").title = ws.root || "";
+    } else {
+      $("proj-name").textContent = "—";
+      $("proj-path").textContent = "";
+    }
+  }
+
+  // ==================================================================
+  // 事件绑定
+  // ==================================================================
+  $("btn-gen-top").addEventListener("click", openGenDialog);
+  $("btn-gen-cancel").addEventListener("click", closeGenDialog);
+  $("btn-gen-start").addEventListener("click", doGenerate);
+  // 需求草稿随画布布局一起进共享面板状态(防抖保存)
+  $("gen-prompt").addEventListener("input", scheduleSaveLayout);
+  $("gen-overlay").addEventListener("click", function (ev) {
+    if (ev.target === $("gen-overlay")) closeGenDialog();
+  });
+
+  $("btn-reload").addEventListener("click", function () {
+    var sel = currentScreen();
+    reloadScreens(sel ? sel.id : "").then(function (screens) {
+      toast("已从磁盘读取 " + (screens ? screens.length : 0) + " 屏");
+    }).catch(function (e) { toast("读盘失败:" + e.message, true); });
+  });
+
+  $("btn-import").addEventListener("click", doImport);
+  $("btn-export").addEventListener("click", doExport);
+
+  $("btn-play-top").addEventListener("click", openPlay);
+  $("btn-play-close").addEventListener("click", closePlay);
+  $("btn-play-prev").addEventListener("click", function () { playStep(-1); });
+  $("btn-play-next").addEventListener("click", function () { playStep(1); });
+  $("btn-play-toggle").addEventListener("click", function () { setPlaying(!state.playing); });
+
+  $("btn-add-page").addEventListener("click", addPage);
+  $("btn-sidebar-collapse").addEventListener("click", toggleSidebar);
+  $("btn-sidebar-open").addEventListener("click", toggleSidebar);
+
+  $("btn-zoom-in").addEventListener("click", function () { setZoom(state.zoom + 0.1); });
+  $("btn-zoom-out").addEventListener("click", function () { setZoom(state.zoom - 0.1); });
+  $("btn-zoom-fit").addEventListener("click", zoomFit);
+  $("btn-grid-toggle").addEventListener("click", toggleGrid);
+
+  Array.prototype.forEach.call(document.querySelectorAll("#viewport-pill button"), function (b) {
+    b.addEventListener("click", function () { setViewport(parseInt(b.dataset.vp, 10)); });
+  });
+
+  // 双击卡片内容区循环切换 html → jsx → vue
+  $("canvas-grid").addEventListener("dblclick", function (ev) {
+    var card = ev.target.closest ? ev.target.closest(".screen-card") : null;
+    if (card) cycleFormat();
+  });
+
+  document.addEventListener("keydown", function (ev) {
+    if (ev.target && (ev.target.tagName === "TEXTAREA" || ev.target.tagName === "INPUT" || ev.target.tagName === "SELECT")) return;
+    if (ev.key === "Escape") {
+      if ($("play-overlay").classList.contains("open")) closePlay();
+      else if ($("gen-overlay").classList.contains("open")) closeGenDialog();
+      return;
+    }
+    if ($("play-overlay").classList.contains("open")) {
+      if (ev.key === "ArrowRight") { ev.preventDefault(); playStep(1); }
+      else if (ev.key === "ArrowLeft") { ev.preventDefault(); playStep(-1); }
+      else if (ev.key === " ") { ev.preventDefault(); setPlaying(!state.playing); }
+    }
+  });
+
+  // ==================================================================
+  // boot — 先握手;渲染错误不得阻塞握手
+  // ==================================================================
+  applySidebar();
+  $("screen-canvas").classList.toggle("grid-on", state.grid);
+  try {
+    renderTree();
+    renderCards();
+  } catch (e) { /* 初始渲染失败不阻塞握手 */ }
+
+  bridge.connect().then(function (mode) {
+    try {
+      $("bridge-dot").className = mode === "mcp" ? "ok" : "";
+      $("bridge-dot").title = mode === "mcp" ? "MCP 桥已连接" : "本地演示模式(未检测到宿主桥)";
+      // 读回工作区画布布局 + 项目信息(顶栏项目名/路径)
+      bridge.callTool("uigen_canvas_get", {}).then(function (res) {
+        try {
+          if (res && res.ok) {
+            setWorkspace(res.workspace);
+            if (res.layout) {
+              applyLayout(res.layout);
+              applySidebar();
+              $("screen-canvas").classList.toggle("grid-on", state.grid);
+              Array.prototype.forEach.call(document.querySelectorAll("#viewport-pill button"), function (b) {
+                b.classList.toggle("on", String(state.viewport) === b.dataset.vp);
+              });
+              renderCards();
+            }
+          }
+          layoutLoaded = true;   // 读回后才允许防抖保存,避免启动即覆盖
+          restorePendingUi();    // 再恢复选中屏/格式/需求草稿 + 从磁盘读 screens
+        } catch (e) { /* 布局恢复失败忽略 */ }
+      }).catch(function () { layoutLoaded = true; restorePendingUi(); });
+    } catch (e) { /* 连接后初始化失败不拖垮面板 */ }
+  });
+})();
+</script>
+</body>
+</html>
