diff --git a/packages/ui/test/modelProviderWhiteLabelSelection.test.ts b/packages/ui/test/modelProviderWhiteLabelSelection.test.ts
new file mode 100644
index 00000000..06d24bfb
--- /dev/null
+++ b/packages/ui/test/modelProviderWhiteLabelSelection.test.ts
@@ -0,0 +1,133 @@
+// @vitest-environment jsdom
+import { useState } from "react";
+import { renderHook } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import { BUILTIN_MODEL_PROVIDER_IDS } from "@zcode/shared";
+import { useModelProviderNavigation } from "@/settings/model-provider-section/useModelProviderNavigation.js";
+import {
+  createCustomProviderNodeKey,
+  createPresetProviderNodeKey,
+} from "@/settings/model-provider-section/utils.js";
+import type { ProviderSettingsFormProvider } from "@/lib/providerSettingsFormTypes.js";
+import type { PresetProviderSpec } from "@/settings/model-provider-section/constants.js";
+
+// 白标：侧栏只展示自定义供应商。选中校正必须与该可见性收敛到同一目标，
+// 否则回退 effect 会把选中写回隐藏的预置 key，与可见性校正互抢
+// selectedNodeKey 形成无限重渲染（React #185，打包后点开模型配置即崩）。
+const isWhiteLabelNavItemVisible = (item: { type: string }) => item.type === "custom";
+
+function createCustomProvider(providerId: string): ProviderSettingsFormProvider {
+  return {
+    providerId,
+    providerName: providerId,
+    templateId: undefined,
+    enabled: true,
+    executable: true,
+    hasPersonalConfig: true,
+    config: {
+      group: "standard-personal",
+      access: { type: "api-key", apiKey: "key" },
+      api: { type: "anthropic-messages", baseUrl: "https://example.com" },
+      builtinModelIds: [],
+    },
+    personalConfig: {},
+  } as unknown as ProviderSettingsFormProvider;
+}
+
+const presetProviders: Array<PresetProviderSpec & { provider: ProviderSettingsFormProvider | null }> =
+  [
+    {
+      id: BUILTIN_MODEL_PROVIDER_IDS.zaiStartPlan,
+      displayName: "Z.ai",
+      provider: null,
+    },
+  ];
+
+function renderSelectionHarness({
+  initialSelectedNodeKey = null,
+  modelProviders = [],
+}: {
+  initialSelectedNodeKey?: string | null;
+  modelProviders?: ProviderSettingsFormProvider[];
+} = {}) {
+  const setSelectedNodeKey = vi.fn();
+  const harness = renderHook(
+    ({ selectedNodeKey }: { selectedNodeKey: string | null }) => {
+      const [innerSelectedNodeKey, innerSetSelectedNodeKey] = useState(selectedNodeKey);
+      useModelProviderNavigation({
+        presetProviders,
+        modelProviders,
+        selectedNodeKey: innerSelectedNodeKey,
+        setSelectedNodeKey: (key) => {
+          setSelectedNodeKey(key);
+          innerSetSelectedNodeKey(key);
+        },
+        intl: { formatMessage: ({ id }: { id: string }) => id } as never,
+        isNavItemVisible: isWhiteLabelNavItemVisible,
+      });
+      return innerSelectedNodeKey;
+    },
+    { initialProps: { selectedNodeKey: initialSelectedNodeKey } },
+  );
+  return { ...harness, setSelectedNodeKey };
+}
+
+describe("白标模型配置选中项收敛", () => {
+  it("无自定义供应商时选中稳定为空，不回落到隐藏的预置 key", () => {
+    const { result, setSelectedNodeKey, rerender } = renderSelectionHarness();
+
+    expect(result.current).toBeNull();
+    for (const [key] of setSelectedNodeKey.mock.calls) {
+      expect(key).not.toBe(createPresetProviderNodeKey(BUILTIN_MODEL_PROVIDER_IDS.zaiStartPlan));
+    }
+    // 反复渲染不改写选中项：互抢效应下这里会持续震荡直至 #185。
+    const settledCalls = setSelectedNodeKey.mock.calls.length;
+    rerender({ selectedNodeKey: null });
+    rerender({ selectedNodeKey: null });
+    expect(result.current).toBeNull();
+    expect(setSelectedNodeKey.mock.calls.length).toBe(settledCalls);
+  });
+
+  it("未选中时默认落在第一个自定义供应商上", () => {
+    const { result, rerender } = renderSelectionHarness({
+      modelProviders: [createCustomProvider("official-api"), createCustomProvider("another-api")],
+    });
+
+    expect(result.current).toBe(createCustomProviderNodeKey("official-api"));
+    rerender({ selectedNodeKey: result.current });
+    expect(result.current).toBe(createCustomProviderNodeKey("official-api"));
+  });
+
+  it("落在隐藏预置入口上的选中被校正到自定义供应商", () => {
+    const { result, rerender } = renderSelectionHarness({
+      initialSelectedNodeKey: createPresetProviderNodeKey(BUILTIN_MODEL_PROVIDER_IDS.zaiStartPlan),
+      modelProviders: [createCustomProvider("official-api")],
+    });
+
+    expect(result.current).toBe(createCustomProviderNodeKey("official-api"));
+    rerender({ selectedNodeKey: result.current });
+    expect(result.current).toBe(createCustomProviderNodeKey("official-api"));
+  });
+
+  it("落在隐藏预置入口上的选中在无自定义供应商时校正为空", () => {
+    const { result, rerender } = renderSelectionHarness({
+      initialSelectedNodeKey: createPresetProviderNodeKey(BUILTIN_MODEL_PROVIDER_IDS.zaiStartPlan),
+    });
+
+    expect(result.current).toBeNull();
+    rerender({ selectedNodeKey: result.current });
+    expect(result.current).toBeNull();
+  });
+
+  it("校正只写可见 key：回退永不携带隐藏节点", () => {
+    const { setSelectedNodeKey } = renderSelectionHarness({
+      initialSelectedNodeKey: createPresetProviderNodeKey(BUILTIN_MODEL_PROVIDER_IDS.zaiStartPlan),
+      modelProviders: [createCustomProvider("official-api")],
+    });
+
+    expect(setSelectedNodeKey).toHaveBeenCalled();
+    for (const [key] of setSelectedNodeKey.mock.calls) {
+      expect(key === null || key.startsWith("custom:")).toBe(true);
+    }
+  });
+});
diff --git a/packages/ui/test/workspaceSidebarFooterEntryRow.test.ts b/packages/ui/test/workspaceSidebarFooterEntryRow.test.ts
new file mode 100644
index 00000000..e1caf115
--- /dev/null
+++ b/packages/ui/test/workspaceSidebarFooterEntryRow.test.ts
@@ -0,0 +1,106 @@
+// @vitest-environment jsdom
+import { createElement } from "react";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import { WorkspaceSidebarFooter } from "@/WorkspaceSidebarFooter.js";
+import {
+  TID_AUTOMATIONS_OPEN,
+  TID_SIDEBAR_CODING_PLAN_USAGE_BUTTON,
+  TID_TASK_SETTINGS_BUTTON,
+} from "@zcode/shared/test-ids";
+
+vi.mock("@/ControlHintTooltip.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/ControlHintTooltip.js")>()),
+  ControlHintTooltip: ({ children, title }: { children: unknown; title: string }) =>
+    createElement("span", { "data-tooltip-title": title }, children),
+}));
+
+vi.mock("@/i18n/IntlProvider.js", () => ({
+  useZCodeIntl: () => ({
+    intl: { formatMessage: ({ id }: { id: string }) => id },
+  }),
+}));
+
+afterEach(cleanup);
+
+function footerProps(overrides: Record<string, unknown> = {}) {
+  return {
+    theme: "light",
+    localeMenuValue: "zh-CN",
+    onLocaleChange: vi.fn(),
+    onThemeChange: vi.fn(),
+    ...overrides,
+  } as Parameters<typeof WorkspaceSidebarFooter>[0];
+}
+
+it("入口行顺序:自动化 → 使用统计 → 插件市场 → 设置,自动化/插件市场仅图标", () => {
+  const onOpenAutomations = vi.fn();
+  const onOpenPluginStore = vi.fn();
+  render(
+    createElement(
+      WorkspaceSidebarFooter,
+      footerProps({
+        onSettingsButtonClick: vi.fn(),
+        onOpenAutomations,
+        onOpenPluginStore,
+      }),
+    ),
+  );
+  const scheduled = screen.getByTestId(TID_AUTOMATIONS_OPEN);
+  const usage = screen.getByTestId(TID_SIDEBAR_CODING_PLAN_USAGE_BUTTON);
+  const plugins = screen.getByTestId("plugin-store-sidebar-open");
+  const settings = screen.getByTestId(TID_TASK_SETTINGS_BUTTON);
+
+  // 仅图标入口：不渲染文字，悬停提示（data-tooltip-title）与 aria-label 承载名称。
+  expect(scheduled.textContent).toBe("");
+  expect(plugins.textContent).toBe("");
+  expect(scheduled.getAttribute("aria-label")).toBe("workspace.openScheduledSettings");
+  expect(plugins.getAttribute("aria-label")).toBe("workspace.openPluginsSettings");
+  expect(
+    scheduled.parentElement?.getAttribute("data-tooltip-title"),
+  ).toBe("workspace.openScheduledSettings");
+
+  // DOM 顺序即行内顺序。
+  const order = [scheduled, usage, plugins, settings];
+  for (let i = 1; i < order.length; i += 1) {
+    expect(
+      order[i - 1]!.compareDocumentPosition(order[i]!) & Node.DOCUMENT_POSITION_FOLLOWING,
+    ).toBeTruthy();
+  }
+
+  fireEvent.click(scheduled);
+  expect(onOpenAutomations).toHaveBeenCalledOnce();
+  // 回归：onClick 不能把点击事件当 automationId 传进 OpenAutomationsMain（曾致自动化打不开）。
+  expect(onOpenAutomations).toHaveBeenCalledWith();
+  fireEvent.click(plugins);
+  expect(onOpenPluginStore).toHaveBeenCalledOnce();
+});
+
+it("未传 handler（Settings 复用 footer）时自动化/插件市场不渲染", () => {
+  render(
+    createElement(
+      WorkspaceSidebarFooter,
+      footerProps({ onSettingsButtonClick: vi.fn() }),
+    ),
+  );
+  expect(screen.queryByTestId(TID_AUTOMATIONS_OPEN)).toBeNull();
+  expect(screen.queryByTestId("plugin-store-sidebar-open")).toBeNull();
+  expect(screen.getByTestId(TID_SIDEBAR_CODING_PLAN_USAGE_BUTTON)).toBeTruthy();
+  expect(screen.getByTestId(TID_TASK_SETTINGS_BUTTON)).toBeTruthy();
+});
