+  // ── 插件 UI「插入到输入框」事件（ui/insert-input-text）→ 文本追加进 composer，不发送 ──
+  // 不随 listenAddToChatEvents 走：触发方（插件面板）刚点过自己，composer 此刻多半失焦，
+  // 但插入恰恰要在此时发生，插入后再把焦点交回 composer 续写。
+  useEffect(() => {
+    if (typeof window === "undefined") {
+      return;
+    }
+    const handlePluginUiInsertInputText = (event: Event) => {
+      if (!isPluginUiInsertInputTextEvent(event)) {
+        return;
+      }
+      // 只接住绑定到本 composer 会话的插入请求（草稿态 sessionId=null 不接）。
+      if (event.detail.sessionId !== sessionId) {
+        return;
+      }
+      const inputApi = inputApiRef.current;
+      if (!inputApi || disabled) {
+        return;
+      }
+      event.preventDefault();
+      inputApi.appendText(event.detail.text);
+      updateText(inputApi.getMarkdown());
+      scheduleDraftPersist();
+      requestComposerFocus();
+    };
+    window.addEventListener(PLUGIN_UI_INSERT_INPUT_TEXT_EVENT, handlePluginUiInsertInputText);
+    return () => {
+      window.removeEventListener(PLUGIN_UI_INSERT_INPUT_TEXT_EVENT, handlePluginUiInsertInputText);
+    };
+  }, [disabled, requestComposerFocus, scheduleDraftPersist, sessionId, updateText]);
