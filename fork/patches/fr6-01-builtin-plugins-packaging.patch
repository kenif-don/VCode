+      card.addEventListener("dragstart", function (ev) {
+        card.classList.add("dragging");
+        ev.dataTransfer.setData("text/plain", String(i));
+        ev.dataTransfer.effectAllowed = "move";
+      });
+      card.addEventListener("dragend", function () { card.classList.remove("dragging"); });
+      card.addEventListener("dragover", function (ev) {
+        ev.preventDefault();
+        ev.dataTransfer.dropEffect = "move";
+      });
+      card.addEventListener("drop", function (ev) {
+        ev.preventDefault();
+        var from = parseInt(ev.dataTransfer.getData("text/plain"), 10);
+        var to = i;
+        if (isNaN(from) || from === to) return;
+        var moved = state.screens.splice(from, 1)[0];
+        state.screens.splice(to, 0, moved);
+        if (state.selected === from) state.selected = to;
+        else if (from < state.selected && to >= state.selected) state.selected -= 1;
+        else if (from > state.selected && to <= state.selected) state.selected += 1;
+        logLine("排序调整:" + moved.name + " → 第 " + (to + 1) + " 位");
+        renderCanvas();
+        renderPreview();
+      });
+
+      grid.appendChild(card);
+    });
+    applyZoom();
+  }
+
+  function applyZoom() {
+    var grid = $("canvas-grid");
+    grid.style.transform = "scale(" + state.zoom + ")";
+    $("zoom-label").textContent = Math.round(state.zoom * 100) + "%";
+  }
+
+  function setZoom(z) {
+    state.zoom = Math.min(1.6, Math.max(0.5, z));
+    applyZoom();
+  }
+
+  // ------------------------------------------------------------------
+  // preview 390px + hotspots (FR-2-2 / FR-2-4)
+  // ------------------------------------------------------------------
+  function currentScreen() {
+    return state.screens[state.selected] || null;
+  }
+
+  function renderPreview() {
+    var s = currentScreen();
+    var frame = $("preview-frame");
+    var layer = $("hotspot-layer");
+    layer.textContent = "";
+    if (!s) {
+      frame.srcdoc = "<!doctype html><html><body style=\"font-family:system-ui;color:#888;padding:24px\">未选择屏幕</body></html>";
+      $("preview-title").textContent = "未选择屏幕";
+      renderArtifact();
+      return;
+    }
+    frame.srcdoc = s.html || "<!doctype html><html><body>该屏幕没有 HTML 产物</body></html>";
+    $("preview-title").textContent = (s.name || s.id) + " · 390 × 844";
+    if ($("hotspot-toggle").checked) {
+      (s.hotspots || []).forEach(function (h) {
+        var el = document.createElement("div");
+        el.className = "hotspot";
+        el.style.left = h.x + "px";
+        el.style.top = h.y + "px";
+        el.style.width = h.w + "px";
+        el.style.height = h.h + "px";
+        var label = document.createElement("span");
+        label.className = "hs-label";
+        label.textContent = "→ " + (h.label || h.to);
+        el.appendChild(label);
+        el.addEventListener("click", function () {
+          var target = state.screens.findIndex(function (x) { return x.id === h.to; });
+          if (target >= 0) {
+            selectScreen(target);
+            logLine("热点跳转:" + (s.name || s.id) + " → " + (state.screens[target].name || h.to));
+          }
+        });
+        layer.appendChild(el);
+      });
+    }
+  }
+
+  function renderArtifact() {
+    var s = currentScreen();
+    var code = $("artifact-code");
+    if (!s) { code.textContent = "(选择屏幕后查看产物)"; return; }
+    code.textContent = s[state.format] || "(该格式无产物)";
+  }
+
+  function selectScreen(i) {
+    if (i < 0 || i >= state.screens.length) return;
+    state.selected = i;
+    renderCanvas();
+    renderPreview();
+    renderArtifact();
+    updatePlayStatus();
+  }
+
+  // ------------------------------------------------------------------
+  // demo playback (FR-2-5): play / pause / step
+  // ------------------------------------------------------------------
+  function updatePlayStatus() {
+    var n = state.screens.length;
+    var pos = state.selected >= 0 ? (state.selected + 1) + "/" + n : "-/" + n;
+    $("play-status").textContent = (state.playing ? "播放中 " : "已暂停 ") + pos;
+    $("btn-play").textContent = state.playing ? "⏸ 暂停" : "▶ 播放";
+  }
+
+  function step(delta) {
+    if (!state.screens.length) return;
+    var next = state.selected + delta;
+    if (next < 0) next = state.screens.length - 1;
+    if (next >= state.screens.length) next = 0;
+    selectScreen(next);
+    updatePlayStatus();
+  }
+
+  function togglePlay() {
+    if (!state.screens.length) { setStatus("没有可播放的屏幕", true); return; }
+    state.playing = !state.playing;
+    if (state.playing) {
+      state.playTimer = setInterval(function () { step(1); }, 2200);
+      logLine("演示播放开始");
+    } else {
+      clearInterval(state.playTimer);
+      state.playTimer = null;
+      logLine("演示播放暂停");
+    }
+    updatePlayStatus();
+  }
+
+  // ------------------------------------------------------------------
+  // versions / import / export (FR-2-6 / FR-2-7 / FR-2-8)
+  // ------------------------------------------------------------------
+  async function refreshVersions() {
+    try {
+      var res = await bridge.callTool("uigen_list_versions", { limit: 30 });
+      var list = $("version-list");
+      list.textContent = "";
+      var versions = (res && res.versions) || [];
+      if (!versions.length) {
+        var li0 = document.createElement("li");
+        li0.className = "v-meta";
+        li0.textContent = "暂无版本";
+        list.appendChild(li0);
+        return;
+      }
+      versions.forEach(function (v) {
+        var li = document.createElement("li");
+        if (v.id === state.versionId) li.className = "on";
+        var t = document.createElement("div");
+        t.className = "v-id";
+        t.textContent = v.id;
+        var m = document.createElement("div");
+        m.className = "v-meta";
+        m.textContent = (v.screenCount + " 屏 · " + (v.createdAt || "").slice(0, 19).replace("T", " ") + " · " + (v.prompt || "").slice(0, 24));
+        li.appendChild(t);
+        li.appendChild(m);
+        li.addEventListener("click", function () { loadVersion(v.id); });
+        list.appendChild(li);
+      });
+    } catch (e) {
+      logLine("版本列表刷新失败:" + e.message);
+    }
+  }
+
+  async function loadVersion(id) {
+    try {
+      var res = await bridge.callTool("uigen_get_version", { versionId: id });
+      if (res && res.ok && res.version && Array.isArray(res.version.screens)) {
+        state.screens = res.version.screens;
+        state.versionId = id;
+        renderCanvas();
+        selectScreen(0);
+        setStatus("已载入版本 " + id);
+        logLine("载入版本:" + id);
+        refreshVersions();
+      } else {
+        setStatus("载入失败:" + (res && res.error ? res.error : "未知错误"), true);
+      }
+    } catch (e) {
+      setStatus("载入失败:" + e.message, true);
+    }
+  }
+
+  async function doImport() {
+    var dir = window.prompt("要导入的本地目录(含 *.html):");
+    if (!dir) return;
+    try {
+      var res = await bridge.callTool("uigen_import_dir", { dir: dir });
+      if (res && res.ok) {
+        setStatus("已导入 " + res.imported + " 个原型 → 版本 " + res.versionId);
+        logLine("目录导入:" + res.dir + " → " + res.versionId);
+        await loadVersion(res.versionId);
+      } else {
+        setStatus("导入失败:" + (res && res.error ? res.error : "未知错误"), true);
+      }
+    } catch (e) {
+      setStatus("导入失败:" + e.message, true);
+    }
+  }
+
+  async function doExport() {
+    if (!state.versionId) { setStatus("请先生成或载入一个版本", true); return; }
+    try {
+      var res = await bridge.callTool("uigen_export", { versionId: state.versionId });
+      if (res && res.ok) {
+        var names = (res.files || []).map(function (f) { return f.name; }).join(", ");
+        setStatus("已导出 " + (res.files || []).length + " 个文件 → " + res.targetDir);
+        logLine("导出:" + res.targetDir + " (" + names.slice(0, 80) + ")");
+      } else {
+        setStatus("导出失败:" + (res && res.error ? res.error : "未知错误"), true);
+      }
+    } catch (e) {
+      setStatus("导出失败:" + e.message, true);
+    }
+  }
+
+  // ------------------------------------------------------------------
+  // events
+  // ------------------------------------------------------------------
+  $("btn-generate").addEventListener("click", doGenerate);
+  $("btn-import").addEventListener("click", doImport);
+  $("btn-export").addEventListener("click", doExport);
+  $("btn-refresh-versions").addEventListener("click", refreshVersions);
+  $("zoom-in").addEventListener("click", function () { setZoom(state.zoom + 0.1); });
+  $("zoom-out").addEventListener("click", function () { setZoom(state.zoom - 0.1); });
+  $("zoom-reset").addEventListener("click", function () { setZoom(1); });
+  $("hotspot-toggle").addEventListener("change", renderPreview);
+  $("btn-play").addEventListener("click", togglePlay);
+  $("btn-step-prev").addEventListener("click", function () { step(-1); });
+  $("btn-step-next").addEventListener("click", function () { step(1); });
+
+  Array.prototype.forEach.call(document.querySelectorAll("#format-tabs [data-fmt]"), function (btn) {
+    btn.addEventListener("click", function () {
+      Array.prototype.forEach.call(document.querySelectorAll("#format-tabs [data-fmt]"), function (b) {
+        b.classList.remove("on");
+      });
+      btn.classList.add("on");
+      state.format = btn.dataset.fmt;
+      renderArtifact();
+    });
+  });
+
+  $("btn-copy").addEventListener("click", function () {
+    var s = currentScreen();
+    if (!s) return;
+    var text = s[state.format] || "";
+    function done() { setStatus("已复制 " + state.format + " 产物(" + text.length + " 字符)"); }
+    if (navigator.clipboard && navigator.clipboard.writeText) {
+      navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text, done); });
+    } else {
+      fallbackCopy(text, done);
+    }
+  });
+
+  function fallbackCopy(text, done) {
+    var ta = document.createElement("textarea");
+    ta.value = text;
+    document.body.appendChild(ta);
+    ta.select();
+    try { document.execCommand("copy"); done(); } catch (e) { setStatus("复制失败:" + e.message, true); }
+    document.body.removeChild(ta);
+  }
+
+  document.addEventListener("keydown", function (ev) {
+    if (ev.target && (ev.target.tagName === "TEXTAREA" || ev.target.tagName === "INPUT")) return;
+    if (ev.key === "ArrowRight") { step(1); }
+    else if (ev.key === "ArrowLeft") { step(-1); }
+    else if (ev.key === " ") { ev.preventDefault(); togglePlay(); }
+  });
+
+  // ------------------------------------------------------------------
+  // boot
+  // ------------------------------------------------------------------
+  renderCanvas();
+  renderPreview();
+  updatePlayStatus();
+  bridge.connect().then(function () {
+    setBridgeStatus();
+    refreshVersions();
+  });
+})();
+</script>
+</body>
+</html>
